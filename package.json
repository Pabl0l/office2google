{
	"name": "office2google",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Doble click en archivos Office -> se abren en Google Docs/Sheets/Slides",
	"scripts": {
		"dev": "bun run src/main.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"creds": "bun run scripts/creds.ts",
		"build": "bun build --compile --target=bun-windows-x64 src/main.ts --outfile dist/office2google.exe"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5.6.0"
	}
}
